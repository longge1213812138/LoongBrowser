# Build artifacts
dist/
build_log.txt
.workbuddy/
*.zip

# NOTE: libs/ is NOT ignored on purpose — it holds the WebView2 SDK assemblies
# referenced by build.ps1. Keeping them tracked means a fresh clone can build
# without a NuGet restore step (~890 KB total).

# extracted package cache
temp/

# scratch/diagnostic files written by tooling (must never reach a commit)
*_tmp.txt
*_tmp.md
diag_*.txt
chk.txt
allres_*.txt
status_tmp.txt

# test scratch output (compiled test exe + WebView2 throwaway profile)
tests/_out*/
tests/*_log.txt
